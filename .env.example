# ==========================================
# SMTP Email Settings (ARZ Airport Travel)
# ==========================================

# SMTP Host (e.g. smtp.gmail.com, mail.yourdomain.com, smtp.hostinger.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Secure connection (true for 465, false for 587)
SMTP_SECURE=true

# Your SMTP sender email
SMTP_USER=zafarirshad97@gmail.com

# Your SMTP password (For Gmail, use a 16-character "App Password")
SMTP_PASS=your_app_password_here

# Where you want to receive the customer messages
CONTACT_RECEIVER_EMAIL=zafarirshad97@gmail.com
